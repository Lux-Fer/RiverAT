APP_NAME=RiverAT
APP_ENV=dev
DEBUG=true
SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=postgresql+asyncpg://riverat:123456@127.0.0.1:5433/riverat
REDIS_URL=redis://127.0.0.1:6379/0
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# 会话（cookie 只带 token，数据在 Redis）
SESSION_TTL_SECONDS=28800
# 首次启动建管理员：数据库里没有用户时才生效
ADMIN_USERNAME=admin
ADMIN_PASSWORD=